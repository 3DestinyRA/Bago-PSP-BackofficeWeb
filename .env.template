# ---------------------------------------------------------------------------
# Variables del SERVIDOR (sin prefijo NEXT_PUBLIC_: no viajan al navegador)
# ---------------------------------------------------------------------------

# Secreto para firmar los tokens de ingreso y las cookies de sesion. Obligatorio.
# Generar uno nuevo con: openssl rand -base64 48
AUTH_SECRET=

# Base publica del sitio, para armar el link que va en el mail.
# Ej: https://bago-psp-backoffice-web.vercel.app
AUTH_BASE_URL=

# Salesforce (usuario de integracion)
SALESFORCE_API_AUTH_URL=https://login.salesforce.com
SALESFORCE_GRANT_TYPE=password
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=

# Servicio de mail (backend propio en Heroku, repo Bago-PSP-API -> POST /mail/operator).
# OJO: la app vieja `bago-api-dc57cc803840` ya no existe (Heroku responde "No such app"),
# por eso el link de ingreso nunca llegaba. Esta es la que usa tambien la app mobile.
EMAIL_SERVICE_API_URL=https://bago-api-a264fbcca57d.herokuapp.com/

# Tiene que coincidir con EMAIL_CLIENT_KEY de esa app de Heroku: si no coincide, el
# endpoint responde 201 igual pero NO manda el mail.
EMAIL_SERVICE_API_KEY=

# Solo desarrollo: devuelve el link en la respuesta en lugar de mandar el mail,
# para no escribirle a operadores reales mientras se prueba.
AUTH_DEBUG_RETURN_LINK=0

# ---------------------------------------------------------------------------
# Variables publicas (se inyectan en el navegador)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ASSETS_URL=
NEXT_PUBLIC_BASE_PATH=http://localhost:3000
